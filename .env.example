# Public-safe browser configuration. Local values are printed by `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Canonical server origin used for CSRF validation and Auth redirect destinations.
APP_ORIGIN=http://127.0.0.1:3000

# Server-only operational label; never contains credentials.
APP_ENV=local

# Required only by the narrow, server-only Phase 7 account-bootstrap capability.
# Use SECRET_KEY from `pnpm exec supabase status --output env` locally.
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Never expose server-only credentials to browser code.
# Do not add a NEXT_PUBLIC_ prefix to service/admin/provider secrets.
